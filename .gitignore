# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
*.db

.claude/
.scratch/
.pytest_cache/
.idea/

docs/internal/

frontend/node_modules/
frontend/dist/

.env
# Food images (shipped via rsync, not git)
images/food/*
images/cuisines/*
images/manual/
images/missing.csv
# Re-include .gitkeep stubs so directory structure is preserved in repo
!images/food/.gitkeep
!images/cuisines/.gitkeep

# TWA (Bubblewrap) — everything it generates except the manifest/runbook/store assets
# (regenerable from twa-manifest.json via `bubblewrap update`)
twa/*.keystore
twa/app/
twa/gradle*
twa/build/
twa/build.gradle
twa/settings.gradle
twa/.gradle/
twa/*.aab
twa/*.apk
twa/*.idsig
twa/store_icon.png
twa/manifest-checksum.txt
